# Flutterwave SECRET KEY - NEVER put this in index.html or GitHub Pages.
FLW_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Long random value used to sign verified payment proofs.
APP_SECRET=replace-with-a-long-random-secret

# Exact public URL where your MoneySplit index.html is hosted.
FRONTEND_URL=https://YOUR-FRONTEND-DOMAIN.example

# Exact public URL of this Node payment server. Flutterwave redirects here first.
BACKEND_PUBLIC_URL=https://YOUR-BACKEND-DOMAIN.example

# Render/Railway/etc. normally supplies PORT automatically.
PORT=3000
